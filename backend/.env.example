SHOP_PHONE=+919876543210
SHOP_WHATSAPP=+919876543210
DEFAULT_DELIVERY_FEE=20
FREE_DELIVERY_MIN_AMOUNT=499

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
